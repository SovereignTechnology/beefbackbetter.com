---
import { ui, whatsappUrl, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const href = whatsappUrl(t.waFloat.message);
---

{/* Floating WhatsApp shortcut. Hidden while the hero (which has its own
    CTAs) is on screen; appears once the visitor scrolls into the page. */}
<a
  class="wa-float"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t.waFloat.label}
  title={t.waFloat.label}
  data-visible="false"
>
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 90; /* below the sticky header (100) */
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.45);
    transform: translateY(0);
    transition: transform 0.2s ease, opacity 0.2s ease, visibility 0.2s;
  }

  .wa-float:hover {
    background: #1fb955;
    transform: translateY(-2px);
  }

  .wa-float[data-visible='false'] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      transition: none;
    }
  }

  @media print {
    .wa-float {
      display: none;
    }
  }
</style>

<script>
  const float = document.querySelector<HTMLAnchorElement>('.wa-float');
  const hero = document.querySelector<HTMLElement>('.hero');

  if (float) {
    if (hero && 'IntersectionObserver' in window) {
      // Show the button only after the hero (with its own CTAs) scrolls away.
      const io = new IntersectionObserver(
        ([entry]) => {
          float.dataset.visible = String(!entry.isIntersecting);
        },
        { rootMargin: '-64px 0px 0px 0px' }
      );
      io.observe(hero);
    } else {
      float.dataset.visible = 'true';
    }
  }
</script>
