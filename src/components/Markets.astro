---
import { ui, markets, marketCuts, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="markets" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t.nav.markets}</span>
      <h2>{t.markets.title}</h2>
      <p>{t.markets.subtitle}</p>
    </div>

    <ul class="market-grid">
      {markets.map((m) => (
        <li class="market-card">
          <h3>{m.name}</h3>
          <p class="market-loc">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z" />
            </svg>
            {m.location[lang]}
          </p>
          <dl class="market-meta">
            <div>
              <dt>{t.markets.daysLabel}</dt>
              <dd>{m.days[lang]}</dd>
            </div>
            <div>
              <dt>{t.markets.hoursLabel}</dt>
              <dd>{m.hours}</dd>
            </div>
          </dl>
          {m.mapUrl && (
            <a class="market-map" href={m.mapUrl} target="_blank" rel="noopener noreferrer">
              {t.markets.mapLink} ↗
            </a>
          )}
        </li>
      ))}
    </ul>

    <div class="cuts">
      <h3>{t.markets.cutsTitle}</h3>
      <p class="cuts-note">{t.markets.cutsNote}</p>
      <ul class="cuts-list">
        {marketCuts.map((cut) => (
          <li>{cut[lang]}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .market-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .market-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    border-top: 4px solid var(--rust);
  }

  .market-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .market-card h3 {
    font-size: 1.5rem;
  }

  .market-loc {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.45rem;
    color: var(--brown-500);
    font-weight: 500;
  }

  .market-meta {
    display: flex;
    gap: 1.75rem;
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .market-meta dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brown-500); /* AA-contrast on the paper card (≈7:1) */
    font-weight: 600;
  }

  .market-meta dd {
    margin-top: 0.15rem;
    font-weight: 600;
    color: var(--brown-900);
  }

  .market-map {
    display: inline-block;
    margin-top: 1.2rem;
    font-weight: 600;
    color: var(--rust);
  }

  .market-map:hover {
    text-decoration: underline;
  }

  .cuts {
    margin-top: 2.5rem;
    background: var(--cream-deep);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .cuts h3 {
    font-size: 1.4rem;
  }

  .cuts-note {
    color: var(--brown-500);
    margin-top: 0.3rem;
  }

  .cuts-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }

  .cuts-list li {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-weight: 500;
    font-size: 0.95rem;
  }
</style>
