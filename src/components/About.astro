---
import { ui, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="about" class="section">
  <div class="container about-grid">
    <div class="about-art" aria-hidden="true">
      <!-- Simple grass-fed cow illustration; swap for /images/about.jpg if you like. -->
      <svg viewBox="0 0 200 200" width="100%" height="100%">
        <circle cx="100" cy="100" r="92" fill="var(--cream-deep)" />
        <circle cx="100" cy="100" r="92" fill="none" stroke="var(--rust)" stroke-width="3" stroke-dasharray="6 8" />
        <g transform="translate(48 70)">
          <path d="M6 30 Q0 10 18 8 Q24 -4 40 4 Q60 -6 78 6 Q98 4 96 26 Q104 34 92 44 L86 70 H72 L70 52 H40 L38 70 H24 L20 46 Q4 46 6 30 Z" fill="var(--brown-700)" />
          <circle cx="30" cy="24" r="3" fill="var(--cream)" />
          <path d="M14 10 Q6 0 2 6" stroke="var(--brown-700)" stroke-width="5" fill="none" stroke-linecap="round" />
          <path d="M90 14 Q100 4 104 12" stroke="var(--brown-700)" stroke-width="5" fill="none" stroke-linecap="round" />
        </g>
        <path d="M40 168 q12 -16 24 0 q12 -16 24 0 q12 -16 24 0 q12 -16 24 0" fill="none" stroke="var(--sage)" stroke-width="4" stroke-linecap="round" />
      </svg>
    </div>

    <div class="about-copy">
      <span class="eyebrow">{t.nav.about}</span>
      <h2>{t.about.title}</h2>
      {t.about.paragraphs.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
  }

  .about-art {
    max-width: 320px;
    margin-inline: auto;
  }

  .about-copy .eyebrow {
    display: inline-block;
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 0.6rem;
  }

  .about-copy h2 {
    font-size: clamp(1.9rem, 4.5vw, 2.7rem);
    margin-bottom: 1rem;
  }

  .about-copy p {
    color: var(--brown-700);
    font-size: 1.08rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 720px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-art {
      max-width: 220px;
      order: -1;
    }
  }
</style>
