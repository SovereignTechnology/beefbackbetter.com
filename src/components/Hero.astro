---
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero-cow.webp';
import { ui, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="hero">
  {/* Real <img> (not a CSS background) so the browser discovers the LCP
      image in the HTML and can fetch it at high priority, in AVIF/WebP
      at a size that matches the viewport. */}
  <Picture
    class="hero-bg"
    src={heroImage}
    widths={[480, 768, 1000]}
    sizes="100vw"
    formats={['avif']}
    fallbackFormat="webp"
    alt=""
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="container hero-inner">
    <p class="hero-eyebrow">{t.hero.eyebrow}</p>
    <h1>
      {t.hero.title}<br />
      <span class="accent">{t.hero.titleAccent}</span>
    </h1>
    <p class="hero-sub">{t.hero.subtitle}</p>
    <div class="hero-cta">
      <a class="btn btn--accent btn--lg" href="#markets">{t.hero.ctaMarkets}</a>
      <a class="btn btn--ghost-light btn--lg" href="#orders">{t.hero.ctaOrders}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    /* Solid fallback shown until the photo arrives, so text stays legible. */
    background-color: #0d142c;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Deep-navy overlay for legible text over the photo. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(13, 20, 44, 0.5) 0%, rgba(13, 20, 44, 0.72) 100%);
  }

  .hero-inner {
    padding-top: clamp(4rem, 11vw, 8rem);
    padding-bottom: clamp(4.5rem, 12vw, 8.5rem);
    max-width: 56rem;
  }

  .hero-eyebrow {
    display: inline-block;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    margin-bottom: 1.3rem;
  }

  .hero h1 {
    color: #fff;
    font-weight: 700;
    font-size: clamp(2.7rem, 8vw, 5.2rem);
    margin-bottom: 1.1rem;
  }

  .accent {
    color: var(--sage); /* brand orange */
  }

  .hero-sub {
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    color: rgba(255, 255, 255, 0.92);
    max-width: 40rem;
    margin-bottom: 2rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
</style>
