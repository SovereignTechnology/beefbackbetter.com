---
import { ui, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// Home + the "other language" URL for the toggle.
const home = lang === 'es' ? '/' : '/en/';
const otherLang = lang === 'es' ? '/en/' : '/';

const navLinks = [
  { href: '#markets', label: t.nav.markets },
  { href: '#stores', label: t.nav.stores },
  { href: '#orders', label: t.nav.orders },
  { href: '#about', label: t.nav.about },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home} aria-label={t.nav.homeAria}>
      <img class="brand-logo" src="/images/logo.png" alt="" width="40" height="40" />
      <span class="brand-name">Beef Back Better</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">{t.nav.menu}</span>
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="nav" aria-label={t.nav.ariaPrimary}>
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <a
        class="lang-switch"
        href={otherLang}
        hreflang={lang === 'es' ? 'en' : 'es'}
        lang={lang === 'es' ? 'en' : 'es'}
        aria-label={t.langSwitchLabel}
      >
        {t.toggleTo}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--cream); /* fallback for browsers without color-mix() */
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.18rem;
    color: var(--brown-900);
  }

  .brand-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a {
    font-weight: 500;
    color: var(--brown-700);
    transition: color 0.15s ease;
  }

  .nav a:hover {
    color: var(--rust);
  }

  .lang-switch {
    display: inline-grid;
    place-items: center;
    min-width: 42px;
    padding: 0.35rem 0.6rem;
    border: 2px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 700 !important;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .lang-switch:hover {
    border-color: var(--rust);
    color: var(--rust) !important;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--paper);
    cursor: pointer;
    position: relative;
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 20px;
    height: 2px;
    background: var(--brown-900);
    border-radius: 2px;
    transform: translateX(-50%);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle-bars {
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .nav-toggle-bars::before {
    top: -6px;
  }
  .nav-toggle-bars::after {
    top: 6px;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bars {
    background: transparent;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars::before {
    transform: translateX(-50%) translateY(6px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars::after {
    transform: translateX(-50%) translateY(-6px) rotate(-45deg);
  }

  /* ---- mobile ---- */
  @media (max-width: 820px) {
    .nav-toggle {
      display: block;
    }

    .nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--cream);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-md);
      padding: 0.5rem var(--gutter) 1.25rem;
      transform: translateY(-12px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.2s ease, opacity 0.2s ease, visibility 0.2s;
    }

    .nav[data-open='true'] {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav li a {
      display: block;
      padding: 0.9rem 0.25rem;
      border-bottom: 1px solid var(--line);
      font-size: 1.1rem;
    }

    .lang-switch {
      margin-top: 1rem;
      justify-self: start;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.dataset.open = String(open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close after tapping a link (mobile).
    nav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );

    // Close with the Escape key and return focus to the toggle.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset state whenever we leave the mobile layout (matches the CSS breakpoint).
    const mq = window.matchMedia('(max-width: 820px)');
    mq.addEventListener('change', (e) => {
      if (!e.matches) setOpen(false);
    });
  }

  // Remember the visitor's explicit language choice so auto-detect on "/" never
  // overrides it. The toggle's `lang` attribute holds the target language code.
  const langSwitch = document.querySelector<HTMLAnchorElement>('.lang-switch');
  langSwitch?.addEventListener('click', () => {
    try {
      localStorage.setItem('bbb-lang', langSwitch.getAttribute('lang') || '');
    } catch (e) {}
  });
</script>
