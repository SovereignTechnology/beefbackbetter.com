---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ui, site, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// TODO: add /images/og.jpg (1200×630) then set this to that path for rich previews.
const ogImage: string | null = null;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : null;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />

    <!-- Tell search engines about the other language version -->
    <link rel="alternate" hreflang="es" href={new URL('/', Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_SV' : 'en_US'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content={site.x.handle} />
    <meta name="twitter:creator" content={site.x.handle} />
    <meta name="theme-color" content="#fbf6ec" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <slot />
  </body>
</html>
